# Copy this file to ".env" and fill in values to enable live Gen AI (Claude).
# If no key is provided, ProcureWise automatically runs in deterministic
# "fallback" mode so every screen still works for a reliable demo.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model to use for Gen AI features (optional; sensible default applied)
ANTHROPIC_MODEL=claude-sonnet-5

# Port the local server listens on (optional)
PORT=3000
