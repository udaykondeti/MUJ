# ---------------------------------------------------------------------------
# vLLM + Gemma 4 12B (NVFP4) configuration for `kirakon` (RTX 5060 Ti 16GB)
# Copy this to `.env` and edit as needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# Model to serve. NVFP4 checkpoint of Gemma 4 12B.
# Can be a HuggingFace repo id or an absolute path to a local directory.
MODEL=AxionML/Gemma-4-12B-NVFP4

# Name clients use in the OpenAI API `model` field. Kept short on purpose.
SERVED_MODEL_NAME=gemma-4-12b

# ---- HuggingFace access -----------------------------------------------------
# Gemma is a gated model: accept the license on the model page once, then put
# a read token here (https://huggingface.co/settings/tokens). Leave empty if
# you serve from a fully-local path that needs no download.
HF_TOKEN=

# Where downloaded weights are cached on the host (persisted across restarts).
HF_HOME=/home/kirakon/.cache/huggingface

# ---- Serving ----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Optional bearer token required on every request (recommended if exposed on
# the LAN). Leave empty to disable auth. Clients send:  Authorization: Bearer <key>
API_KEY=

# ---- Memory tuning for 16 GB VRAM ------------------------------------------
# NVFP4 weights are ~6.5 GB; the rest of the 16 GB is CUDA context + KV cache.
# 8192 is a safe default. You can push to 16384 (and even 32768) if you also
# drop MAX_NUM_SEQS to 2 — watch nvidia-smi and back off on OOM at startup.
MAX_MODEL_LEN=8192

# Fraction of the 16 GB vLLM is allowed to claim. 0.90 leaves headroom for the
# desktop/display. Lower it if the machine also drives a monitor.
GPU_MEMORY_UTILIZATION=0.90

# Concurrent request slots. Each one costs KV-cache memory; 4 is comfortable at
# 8k context on 16 GB. Raise MAX_MODEL_LEN => lower this.
MAX_NUM_SEQS=4

# Prefill token budget per step. 4096 keeps peak activation memory in check.
MAX_NUM_BATCHED_TOKENS=4096

# fp8 KV cache roughly halves KV-cache memory — big win on a 16 GB card and
# well supported on Blackwell. Set to "auto" to keep the model dtype instead.
KV_CACHE_DTYPE=fp8

# Compute dtype for the non-quantized layers (Gemma prefers bfloat16).
DTYPE=bfloat16

# Quantization backend. Leave empty to let vLLM auto-detect from the model's
# hf_quant_config.json (works for both modelopt and compressed-tensors NVFP4).
# Set to "modelopt" only if auto-detection ever fails.
QUANTIZATION=

# Docker image. The nightly OpenAI image carries the Blackwell/SM120 kernels.
# Pin to a dated tag once you have a working combo (e.g. vllm/vllm-openai:v0.17.0).
VLLM_IMAGE=vllm/vllm-openai:nightly
